# Built application files
*.apk
*.aab
*.ap_
*.dex
*.idsig

# Keep release apk directory
!release-apk/*.apk

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
app/build/
build/

# Gradle files
.gradle/
buildOutputCleanup/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ IDEA
*.iml
.idea/
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml

# Keystore files
*.jks
*.keystore

# External native build folder
.externalNativeBuild
.cxx/

# OS files
.DS_Store
Thumbs.db

# Kotlin incremental compilation cache (IDE/CLI, never commit)
.kotlin/

# Local screenshots / debug artifacts
*.png
!app/src/main/res/drawable/*.png
!app/src/main/res/mipmap*/*.png
