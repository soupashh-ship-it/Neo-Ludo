<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Player identity and local state must NEVER clone to another device:
         two phones on one Google account would otherwise share one player ID,
         and joining a room would overwrite the host's seat. -->
    <exclude domain="sharedpref" path="neoludo_prefs.preferences_pb" />
    <exclude domain="sharedpref" path="neoludo_prefs" />
    <exclude domain="file" path="datastore/neoludo_prefs.preferences_pb" />
    <exclude domain="file" path="datastore/" />
</full-backup-content>
